local function isAlive(th) return th ~= nil and coroutine.status(th) ~= "dead" end

local function stopKey(key, quiet)
    local th = running[key]
    running[key] = nil
    if isAlive(th) then
        pcall(task.cancel, th)
        if not quiet then setStatus(key .. " detenido") end
        renderTabs()
        return true
    end
    if not quiet then setStatus(key .. ": no hay nada ejecutándose que detener", true) end
    return false
end

local function runCode(key, code)
    if code == "" then setStatus("No hay nada que ejecutar (código vacío)", true) return end
    stopKey(key, true)
    local fn, err = loadstring(code, "=" .. key)
    if not fn then setStatus(key .. ": error de sintaxis - " .. short(err), true) return end
    local th = task.spawn(function()
        local ok, e = pcall(fn)
        local me = coroutine.running()
        if running[key] == me then running[key] = nil end
        if ok then
            setStatus(key .. " terminó")
        else
            setStatus(key .. ": error - " .. short(e), true)
            warn("[Scripts] " .. key .. ": " .. tostring(e))
        end
        renderTabs()
    end)
    if isAlive(th) then
        running[key] = th
        setStatus(key .. " ejecutándose")
        renderTabs()
    end
end

-- ============================================================
-- Auto-guardado: el script abierto se guarda solo ~1 segundo después de que dejas de escribir.
-- Solo aplica a scripts que ya guardaste una vez (los tienes como tab). Nunca pisa un archivo con texto vacío.
-- ============================================================
local saveToken = 0
local function autoSaveNow()
    if not config.autosave or not activeName then return end
    if not isfile(path(activeName)) then return end
    local code = normalize(editor.Text)
    if code == "" or code == lastSaved then return end
    local ok, err = pcall(writefile, path(activeName), code)
    if ok then
        lastSaved = code
        setStatus("Auto-guardado: " .. activeName)
    else
        setStatus("No se pudo auto-guardar: " .. short(err), true)
    end
end

editor:GetPropertyChangedSignal("Text"):Connect(function()
    if not config.autosave or not activeName then return end
    saveToken = saveToken + 1
    local token = saveToken
    task.delay(1.2, function()
        if token == saveToken then autoSaveNow() end
    end)
end)

-- Arrastre de la fila de tabs (sin barra de scroll)
local stripDrag, stripMoved = nil, false
local function beginStripDrag(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    stripDrag = { startX = input.Position.X, startCanvas = strip.CanvasPosition.X, moved = false }
end
local function dragBlocksClick()
    return stripMoved or (stripDrag ~= nil and stripDrag.moved)
end
strip.InputBegan:Connect(beginStripDrag)
conns[#conns + 1] = UserInputService.InputChanged:Connect(function(i)
    if not stripDrag then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local dx = i.Position.X - stripDrag.startX
    if not stripDrag.moved and math.abs(dx) > 6 then stripDrag.moved = true end
    if stripDrag.moved then
        strip.CanvasPosition = Vector2.new(stripDrag.startCanvas - dx, 0)
    end
end)
conns[#conns + 1] = UserInputService.InputEnded:Connect(function(i)
    if not stripDrag then return end
    if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
    if stripDrag.moved then
        stripMoved = true
        task.delay(0.15, function() stripMoved = false end)
    end
    stripDrag = nil
end)

-- Si la tab activa quedó fuera de la vista, la trae.
local function revealActive()
    task.defer(function()
        local t = activeName and strip:FindFirstChild(activeName)
        if not t then return end
        local left = t.AbsolutePosition.X - strip.AbsolutePosition.X + strip.CanvasPosition.X
        local right = left + t.AbsoluteSize.X
        local view = strip.AbsoluteSize.X
        if left < strip.CanvasPosition.X then
            strip.CanvasPosition = Vector2.new(math.max(0, left - 4), 0)
        elseif right > strip.CanvasPosition.X + view then
            strip.CanvasPosition = Vector2.new(right - view + 4, 0)
        end
    end)
end

local function loadScript(name)
    autoSaveNow() -- por si venías escribiendo en otro script
    if not isfile(path(name)) then setStatus("No se encontró el archivo: " .. name, true) renderTabs() return end
    local ok, content = pcall(readfile, path(name))
    if not ok then setStatus("No se pudo abrir " .. name .. ": " .. short(content), true) return end
    activeName = name
    nameBox.Text = name
    lastSaved = content
    editor.Text = content
    config.last = name
    saveConfig()
    refreshToggles()
    renderTabs()
    revealActive()
    setStatus("Abierto " .. name)
end

local function deleteScript(name)
    stopKey(name, true)
    pcall(delfile, path(name))
    if autorun[name] then autorun[name] = nil saveAutorun() end
    if activeName == name then
        activeName = nil
        nameBox.Text = ""
        editor.Text = ""
        lastSaved = ""
        config.last = nil
        saveConfig()
    end
    refreshToggles()
    renderTabs()
    setStatus("Eliminado " .. name)
end

-- Eliminar pide confirmar: la primera vez avisa, la segunda (dentro de 4 s) borra.
local function requestDelete(name)
    if not name or name == "" or not isfile(path(name)) then
        setStatus("Elige primero un script guardado", true)
        return
    end
    if pendingDel and pendingDel.name == name and os.clock() - pendingDel.at <= 4 then
        pendingDel = nil
        deleteScript(name)
        return
    end
    local at = os.clock()
    pendingDel = { name = name, at = at }
    setStatus("Pulsa otra vez para eliminar \"" .. name .. "\" (no se puede deshacer)", true)
    renderTabs()
    task.delay(4.1, function()
        if pendingDel and pendingDel.at == at then
            pendingDel = nil
            renderTabs()
        end
    end)
end

local function makeTab(name, order)
    local sel = name == activeName
    local pend = pendingDel ~= nil and pendingDel.name == name
    local label = (isAlive(running[name]) and "* " or "") .. name .. (autorun[name] and " (auto)" or "")
    local w = math.clamp(math.ceil(textWidth(label, 12, Enum.Font.GothamMedium)) + 50, 84, 210)

    local tab = new("Frame", {
        Name = name, LayoutOrder = order, Size = UDim2.fromOffset(w, 26), BorderSizePixel = 0,
        BackgroundColor3 = pend and TXT_BAD or (sel and PINK or WHITE),
    }, strip)
    corner(tab, 13)
    stroke(tab, sel and PINK_D or PINK_L, 1)

    local btn = new("TextButton", {
        Size = UDim2.new(1, -26, 1, 0), BackgroundTransparency = 1, AutoButtonColor = false, Text = label,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = (sel or pend) and WHITE or TXT,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, tab)
    new("UIPadding", { PaddingLeft = UDim.new(0, 12) }, btn)

    local x = new("TextButton", {
        Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -22, 0.5, -9), AutoButtonColor = false,
        BackgroundColor3 = (sel or pend) and PINK_D or PINK_L, Text = pend and "?" or "×",
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = (sel or pend) and WHITE or TXT,
    }, tab)
    corner(x, 9)

    btn.InputBegan:Connect(beginStripDrag)
    btn.MouseButton1Click:Connect(function()
        if dragBlocksClick() then return end
        loadScript(name)
    end)
    x.MouseButton1Click:Connect(function() requestDelete(name) end)
end

function renderTabs()
    for _, c in ipairs(strip:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
    local q = search.Text:lower()
    local shown = 0
    for i, name in ipairs(listScripts()) do
        if q == "" or name:lower():find(q, 1, true) then
            shown = shown + 1
            makeTab(name, i)
        end
    end
    if shown == 0 then
        new("TextLabel", {
            Name = "_vacio", LayoutOrder = 1, Size = UDim2.fromOffset(260, 26), BackgroundTransparency = 1,
            Text = q ~= "" and "Ninguna tab coincide con la búsqueda" or "Aún no hay scripts guardados",
            Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TXT_SOFT, TextXAlignment = Enum.TextXAlignment.Left,
        }, strip)
    end
end

local function saveScript()
    local name = clean(nameBox.Text)
    if name == "" then setStatus("Escribe un nombre primero", true) return end
    local code = normalize(editor.Text)
    if code == "" then setStatus("No hay nada que guardar (código vacío)", true) return end
    local ok, err = pcall(writefile, path(name), code)
    if not ok then setStatus("No se pudo guardar: " .. short(err), true) return end
    activeName = name
    nameBox.Text = name
    lastSaved = code
    editor.Text = code
    config.last = name
    saveConfig()
    refreshToggles()
    renderTabs()
    revealActive()
    setStatus("Guardado " .. name .. (config.autosave and " - desde ahora se auto-guarda" or ""))
end

