local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, c, t) return new("UIStroke", { Color = c, Thickness = t }, o) end
local function pad(o, n)
    return new("UIPadding", { PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n), PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n) }, o)
end

local function clean(name)
    return (tostring(name or ""):gsub("[^%w _%-]", "_"):match("^%s*(.-)%s*$"):sub(1, 40))
end
local function path(name) return FOLDER .. "/" .. name .. ".lua" end
local function short(e) return (tostring(e):gsub("%s+", " "):sub(1, 90)) end

local function normalize(text)
    text = tostring(text or ""):match("^%s*(.-)%s*$")
    if text:match("^https?://%S+$") then
        return 'loadstring(game:HttpGet("' .. text .. '"))()'
    end
    return text
end

local function textWidth(text, size, font)
    local ok, w = pcall(function() return TextService:GetTextSize(text, size, font, Vector2.new(1000, 30)).X end)
    if ok and w then return w end
    return #text * size * 0.6
end

local function listScripts()
    local out = {}
    local ok, files = pcall(listfiles, FOLDER)
    if ok and type(files) == "table" then
        for _, f in ipairs(files) do
            local n = tostring(f):match("([^/\\]+)%.lua$")
            if n then out[#out + 1] = n end
        end
    end
    table.sort(out, function(a, b) return a:lower() < b:lower() end)
    return out
end

local function saveAutorun()
    local list = {}
    for n in pairs(autorun) do list[#list + 1] = n end
    table.sort(list)
    pcall(writefile, AUTORUN_FILE, HttpService:JSONEncode(list))
end

local function loadAutorun()
    if not isfile(AUTORUN_FILE) then return end
    local ok, list = pcall(function() return HttpService:JSONDecode(readfile(AUTORUN_FILE)) end)
    if ok and type(list) == "table" then
        for _, n in ipairs(list) do autorun[n] = true end
    end
end

-- Configuración guardada: auto-guardado SÍ/NO, último script abierto y dónde dejaste la ventana.
local function saveConfig()
    pcall(writefile, CONFIG_FILE, HttpService:JSONEncode(config))
end
local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if ok and type(data) == "table" then
        if data.autosave ~= nil then config.autosave = data.autosave == true end
        if type(data.last) == "string" then config.last = data.last end
        if type(data.win) == "table" then config.win = data.win end
    end
end

