end)

do
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        body.Visible = not minimized
        win.Size = UDim2.fromOffset(WIN_W, minimized and 34 or WIN_H)
        topFill.Visible = not minimized -- minimizada: la barra queda como una píldora redonda
    end)
    closeBtn.MouseButton1Click:Connect(function()
        autoSaveNow()
        gui.Enabled = false
    end)
end

-- Mover la ventana (arrastrando la barra de arriba). La posición queda guardada.
do
    local dragging, dragStart, startPos = false, nil, nil
    top.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, win.Position
        end
    end)
    conns[#conns + 1] = UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    conns[#conns + 1] = UserInputService.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dragging then
            dragging = false
            local p = win.Position
            if p ~= startPos then
                config.win = { xs = p.X.Scale, xo = p.X.Offset, ys = p.Y.Scale, yo = p.Y.Offset }
                saveConfig()
            end
        end
    end)
end

conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == TOGGLE_KEY and not UserInputService:GetFocusedTextBox() then
        if gui.Enabled then autoSaveNow() end
        gui.Enabled = not gui.Enabled
    end
end)

_G.__AzucarScriptsCleanup = function()
    pcall(autoSaveNow)
    for key in pairs(running) do
        local th = running[key]
        running[key] = nil
        if isAlive(th) then pcall(task.cancel, th) end
    end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
end

-- Arranque: cargar lo recordado, abrir el último script y lanzar los de "Ejecutar al iniciar".
loadAutorun()
loadConfig()
if type(config.win) == "table" and tonumber(config.win.xo) and tonumber(config.win.yo) then
    win.Position = UDim2.new(tonumber(config.win.xs) or 0, config.win.xo, tonumber(config.win.ys) or 0, config.win.yo)
end
refreshToggles()
renderTabs()
if config.last and isfile(path(config.last)) then
    loadScript(config.last)
end

task.spawn(function()
    task.wait(1.5)
    local names = {}
    for n in pairs(autorun) do names[#names + 1] = n end
    table.sort(names)
    for _, n in ipairs(names) do
        if isfile(path(n)) then runCode(n, normalize(readfile(path(n)))) end
        task.wait(0.3)
    end
end)
